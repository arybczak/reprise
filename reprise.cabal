cabal-version:      3.8
build-type:         Simple
name:               reprise
version:            1.0.0.0
license:            BSD-3-Clause
license-file:       LICENSE
category:           Sound
maintainer:         andrzej@rybczak.net
author:             Andrzej Rybczak
synopsis:           A terminal client for the Music Player Daemon.

description:
  A terminal client for the <https://www.musicpd.org Music Player Daemon>
  (MPD).

extra-doc-files:
  CHANGELOG.md
  README.md

extra-source-files:
  cbits/pocketfft/LICENSE.md
  cbits/pocketfft/pocketfft.h
  src/mpd-protocol/README.md
  tests/mpd-protocol/replies/*.golden
  tests/mpd-protocol/replies/*.txt
  tests/reprise/golden/*.txt
  tests/reprise/lrclib/*.json
  tests/reprise/tekstowo/*.html

tested-with: GHC ^>= { 9.6, 9.8, 9.10, 9.12, 9.14 }

bug-reports: https://github.com/arybczak/reprise/issues
source-repository head
  type:     git
  location: https://github.com/arybczak/reprise.git

common language
    ghc-options:        -Wall
                        -Wcompat
                        -Werror=missing-deriving-strategies
                        -Werror=name-shadowing
                        -Werror=prepositive-qualified-module

    default-language:   GHC2021

    default-extensions: DataKinds
                        DeepSubsumption
                        DeriveAnyClass
                        DerivingStrategies
                        DuplicateRecordFields
                        LambdaCase
                        MultiWayIf
                        NoFieldSelectors
                        NoStarIsType
                        OverloadedLabels
                        OverloadedRecordDot
                        OverloadedStrings
                        RoleAnnotations
                        StrictData
                        TypeFamilies
                        UndecidableInstances

-- The client of the MPD protocol. It is a library of its own, so that it
-- can't depend on the rest of reprise and can become a package again.
library mpd-protocol
    import:         language

    visibility:     private

    build-depends:    base                >= 4.18      && < 5
                    , bytestring          >= 0.11.4
                    , containers          >= 0.6.7
                    , deepseq             >= 1.4.8
                    , network             >= 3.1.2
                    , text                >= 2.0.2
                    , text-iso8601        >= 0.2
                    , time                >= 1.12

    hs-source-dirs:  src/mpd-protocol

    exposed-modules: Reprise.Mpd.Protocol.Command
                     Reprise.Mpd.Protocol.Connection
                     Reprise.Mpd.Protocol.Idle
                     Reprise.Mpd.Protocol.Internal.Connection
                     Reprise.Mpd.Protocol.Request
                     Reprise.Mpd.Protocol.Response
                     Reprise.Mpd.Protocol.Types

library
    import:         language

    build-depends:    base                 >= 4.18      && < 5
                    , brick                >= 2.4
                    , bytestring           >= 0.11.4
                    , containers           >= 0.6.7
                    , directory            >= 1.3.8
                    , effectful-core       >= 2.7
                    , filepath             >= 1.4.100
                    , http-client          >= 0.7.17
                    , http-client-tls      >= 0.3.6
                    , http-types           >= 0.12.4
                    , network              >= 3.1.2
                    , optics-core          >= 0.4.1
                    , process              >= 1.6.17
                    , reprise:mpd-protocol
                    , stm                  >= 2.5.1
                    , tagsoup              >= 0.14.8
                    , text                 >= 2.0.2
                    , text-icu             >= 0.8
                    , time                 >= 1.12
                    , vector               >= 0.13
                    , vty                  >= 6.2
                    , vty-unix             >= 0.2
                    , yamlet               >= 1.0

    hs-source-dirs:  src/reprise

    exposed-modules: Reprise.Action
                     Reprise.App
                     Reprise.Collation
                     Reprise.Config
                     Reprise.Effect.Mpd
                     Reprise.Effect.MpdRequest
                     Reprise.Effect.UiRequest
                     Reprise.Event
                     Reprise.Find
                     Reprise.Format
                     Reprise.Groups
                     Reprise.Handler
                     Reprise.Handler.Core
                     Reprise.Keymap
                     Reprise.Keys
                     Reprise.LineEdit
                     Reprise.Lyrics
                     Reprise.Lyrics.Http
                     Reprise.Lyrics.Lrclib
                     Reprise.Lyrics.Tekstowo
                     Reprise.Lyrics.Worker
                     Reprise.Mpd.Address
                     Reprise.Mpd.Mirror
                     Reprise.Mpd.Worker
                     Reprise.Screen.Browser
                     Reprise.Screen.Help
                     Reprise.Screen.Lyrics
                     Reprise.Screen.Queue
                     Reprise.Screen.Queue.Edits
                     Reprise.Screen.Visualizer
                     Reprise.Selection
                     Reprise.State
                     Reprise.Style
                     Reprise.UI.Layout
                     Reprise.UI.SongList
                     Reprise.Visualizer.Samples
                     Reprise.Visualizer.Spectrum
                     Reprise.Visualizer.Worker
                     Reprise.Width

    -- reprise-bench computes the spectra of a frame in 171 µs with -O3,
    -- and in 208 µs without. -ffast-math made no difference beyond the
    -- noise. Cabal doesn't build the C sources again when this changes.
    cc-options:      -O3
    c-sources:       cbits/pocketfft/pocketfft.c
                     cbits/clock.c
                     cbits/spectrum.c
                     cbits/width.c

executable reprise
    import:         language

    -- While a song plays, reprise wakes about once a second to show the
    -- time, and the idle collection then copied the whole heap each time.
    ghc-options:    -threaded "-with-rtsopts=-I0"

    build-depends:    base
                    , brick
                    , directory
                    , effectful-core
                    , filepath
                    , http-client-tls
                    , optparse-applicative >= 0.18
                    , reprise
                    , stm
                    , text
                    , time
                    , vty
                    , vty-unix

    hs-source-dirs: app
    main-is:        Main.hs

    other-modules:   Paths_reprise
    autogen-modules: Paths_reprise

-- A real MPD for the test suites: mpd in a temporary directory, with a null
-- audio output and silent FLAC files that the flac tool makes.
library mpd-test-server
    import:         language

    visibility:     private

    build-depends:    base                >= 4.18      && < 5
                    , bytestring          >= 0.11.4
                    , directory           >= 1.3.8
                    , filepath            >= 1.4.100
                    , network             >= 3.1.2
                    , process             >= 1.6.17
                    , temporary           >= 1.3
                    , text                >= 2.0.2

    hs-source-dirs:  tests/mpd-test-server

    exposed-modules: Reprise.Mpd.TestServer

test-suite mpd-protocol-tests
    import:         language

    ghc-options:    -threaded

    build-depends:    base
                    , bytestring
                    , containers
                    , filepath
                    , ghc-heap
                    , pretty-simple
                    , reprise:mpd-protocol
                    , reprise:mpd-test-server
                    , tasty
                    , tasty-golden
                    , tasty-hunit
                    , text
                    , time

    hs-source-dirs: tests/mpd-protocol

    type:           exitcode-stdio-1.0
    main-is:        Main.hs

    other-modules:  CommandTests
                    ConnectionTests
                    RequestTests
                    ResponseTests
                    Thunks

test-suite reprise-tests
    import:         language

    ghc-options:    -threaded

    build-depends:    base
                    , bytestring
                    , containers
                    , directory
                    , effectful-core
                    , filepath
                    , optics-core
                    , QuickCheck
                    , reprise
                    , reprise:mpd-protocol
                    , reprise:mpd-test-server
                    , stm
                    , tasty
                    , tasty-golden
                    , tasty-hunit
                    , tasty-quickcheck
                    , temporary
                    , text
                    , unix
                    , vector
                    , vty
                    , yamlet

    hs-source-dirs: tests/reprise

    type:           exitcode-stdio-1.0
    main-is:        Main.hs

    other-modules:  ActionTests
                    AddressTests
                    BrowserTests
                    CollationTests
                    ConfigTests
                    FindTests
                    FormatTests
                    HandlerTests
                    HelpTests
                    KeymapTests
                    KeysTests
                    LayerTests
                    LayoutTests
                    LineEditTests
                    LrclibTests
                    LyricsTests
                    MirrorTests
                    QueueTests
                    StyleTests
                    TekstowoTests
                    VisualizerTests
                    WidthTests
                    WorkerTests
                    Utils

benchmark mpd-protocol-bench
    import:         language

    build-depends:    base
                    , bytestring
                    , reprise:mpd-protocol
                    , tasty-bench

    hs-source-dirs: bench/mpd-protocol

    type:           exitcode-stdio-1.0
    main-is:        Main.hs

benchmark reprise-bench
    import:         language

    build-depends:    base
                    , bytestring
                    , containers
                    , deepseq
                    , optics-core
                    , reprise
                    , reprise:mpd-protocol
                    , tasty-bench
                    , text
                    , unix
                    , vector
                    , vty
                    , vty-unix

    hs-source-dirs: bench/reprise

    type:           exitcode-stdio-1.0
    main-is:        Main.hs
