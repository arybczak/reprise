packages: .

constraints:
  , any.cryptonite <0
  , any.memory <0

if impl(ghc >= 10)
  allow-newer:
    , *:base
    , *:ghc-prim
    , *:template-haskell
    , *:time
  source-repository-package
    type: git
    location: https://github.com/arybczak/hashable.git
    tag: 8e193ca5308130dca1363f1c5aa91169b9c1490e
