packages: .

-- yamlet is not on Hackage yet.
source-repository-package
  type: git
  location: https://github.com/arybczak/yamlet.git
  tag: 7065c7a71a2f178a6f3028d6be9abf95c81b7845

-- vty-unix with a faster evaluation of escape sequences, which makes
-- scrolling a list much cheaper, and window titles sent as UTF-8, which
-- keeps titles outside ASCII readable. Until a release of vty-unix has
-- both.
source-repository-package
  type: git
  location: https://github.com/arybczak/vty-unix.git
  tag: 82c2b1ac3caa041dc54794ff41ef5e1b7c485a1a

constraints:
  , any.cryptonite <0
  , any.memory <0

if impl(ghc >= 10)
  allow-newer:
    , *:base
    , *:ghc-prim
    , *:template-haskell
    , *:time
  source-repository-package
    type: git
    location: https://github.com/arybczak/hashable.git
    tag: 8e193ca5308130dca1363f1c5aa91169b9c1490e
