packages: .

-- vty with spans that reuse the known width of a text, and vty-unix with a
-- faster output of decimal numbers and synchronized output. Until releases
-- of both have them.
source-repository-package
  type: git
  location: https://github.com/jtdaugherty/vty.git
  tag: b1772f5c4ff55e98682ec116b592d16a13405194

source-repository-package
  type: git
  location: https://github.com/arybczak/vty-unix.git
  tag: e8a5faf282e94a3a2e96f621aa86cf1bb67118cb

constraints:
  , any.cryptonite <0
  , any.memory <0

if impl(ghc >= 10)
  allow-newer:
    , *:base
    , *:ghc-prim
    , *:template-haskell
    , *:time
  source-repository-package
    type: git
    location: https://github.com/arybczak/hashable.git
    tag: 8e193ca5308130dca1363f1c5aa91169b9c1490e
