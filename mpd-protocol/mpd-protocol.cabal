cabal-version:      3.8
build-type:         Simple
name:               mpd-protocol
version:            0.1.0.0
license:            BSD-3-Clause
license-file:       LICENSE
category:           Network, Sound
maintainer:         andrzej@rybczak.net
author:             Andrzej Rybczak
synopsis:           A client library for the Music Player Daemon protocol.

description:
  A client library for the protocol of the
  <https://www.musicpd.org Music Player Daemon> (MPD).

  Commands are typed values that keep their request lines as plain data. They
  combine with the @Applicative@ interface into command lists, which run in a
  single round trip.

extra-doc-files:
  CHANGELOG.md
  README.md

extra-source-files:
  tests/replies/*.golden
  tests/replies/*.txt

tested-with: GHC ^>= { 9.6, 9.8, 9.10, 9.12, 9.14 }

bug-reports: https://github.com/arybczak/reprise/issues
source-repository head
  type:     git
  location: https://github.com/arybczak/reprise.git
  subdir:   mpd-protocol

common language
    ghc-options:        -Wall
                        -Wcompat
                        -Werror=missing-deriving-strategies
                        -Werror=name-shadowing
                        -Werror=prepositive-qualified-module

    default-language:   GHC2021

    default-extensions: DataKinds
                        DeriveAnyClass
                        DeepSubsumption
                        DerivingStrategies
                        DuplicateRecordFields
                        LambdaCase
                        NoFieldSelectors
                        NoStarIsType
                        OverloadedRecordDot
                        OverloadedStrings
                        RoleAnnotations
                        StrictData
                        TypeFamilies
                        UndecidableInstances

library
    import:         language

    build-depends:    base                >= 4.18      && < 5
                    , bytestring          >= 0.11.4
                    , containers          >= 0.6.7
                    , deepseq             >= 1.4.8
                    , network             >= 3.1.2
                    , text                >= 2.0.2
                    , time                >= 1.12

    hs-source-dirs:  src

    exposed-modules: MPD.Command
                     MPD.Connection
                     MPD.Idle
                     MPD.Internal.Connection
                     MPD.Protocol.Request
                     MPD.Protocol.Response
                     MPD.Types

test-suite test
    import:         language

    ghc-options:    -threaded

    build-depends:    base
                    , bytestring
                    , containers
                    , filepath
                    , ghc-heap
                    , mpd-protocol
                    , mpd-test-server
                    , pretty-simple
                    , tasty
                    , tasty-golden
                    , tasty-hunit
                    , text

    hs-source-dirs: tests

    type:           exitcode-stdio-1.0
    main-is:        Main.hs

    other-modules:  CommandTests
                    ConnectionTests
                    RequestTests
                    ResponseTests
                    Thunks
